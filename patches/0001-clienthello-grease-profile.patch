diff -ruN a/rustls/src/client/client_hello_profile.rs b/rustls/src/client/client_hello_profile.rs
--- a/rustls/src/client/client_hello_profile.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/rustls/src/client/client_hello_profile.rs	2026-11-22 22:00:00.000000000 +0000
@@ -0,0 +1,47 @@
+//! lyrebird: data-driven ClientHello shaping.
+//!
+//! A [`ClientHelloProfile`] carries fingerprint data that must come from
+//! real captures: preference orders and GREASE. Empty preference lists
+//! mean "native order" -- no order is claimed without a pinned capture.
+
+use crate::{CipherSuite, NamedGroup, SignatureScheme};
+
+/// A ClientHello fingerprint profile (lyrebird).
+///
+/// * `grease` adds RFC 8701 GREASE bookends: the first cipher suite, the
+///   first extension, and the first offered protocol version.
+/// * The order slices are preference lists: listed entries move to the
+///   front in the given order; everything else keeps its native order.
+///   An empty list keeps the native order untouched.
+#[derive(Debug)]
+pub struct ClientHelloProfile {
+    /// Emit GREASE bookends (RFC 8701).
+    pub grease: bool,
+    /// Preference order for cipher suites.
+    pub cipher_suites: &'static [CipherSuite],
+    /// Preference order for signature schemes.
+    pub signature_schemes: &'static [SignatureScheme],
+    /// Preference order for key exchange groups.
+    pub named_groups: &'static [NamedGroup],
+}
+
+/// Reorder `offered` so entries named in `preference` come first, in the
+/// preference order. Unlisted entries keep their relative native order.
+pub(crate) fn reorder_by_preference<T: Copy + PartialEq>(
+    offered: alloc::vec::Vec<T>,
+    preference: &'static [T],
+) -> alloc::vec::Vec<T> {
+    if preference.is_empty() {
+        return offered;
+    }
+
+    let mut offered: alloc::vec::Vec<T> = offered;
+    let mut out = alloc::vec::Vec::with_capacity(offered.len());
+    for want in preference {
+        if let Some(idx) = offered.iter().position(|x| *x == *want) {
+            out.push(offered.remove(idx));
+        }
+    }
+    out.append(&mut offered);
+    out
+}

